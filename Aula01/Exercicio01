class Produto:
    def __init__(self, nome, preco, quantidade):
        self.nome= nome
        self.preco= preco
        self.quantidade= quantidade
    def imprimir(self):
        print("nome:", self.nome)
        print("valor:" , self.preco)
        print("quantidade:", self.quantidade)
    def calcular_total(self):
        total = self.preco *self.quantidade
        return total
cebola= Produto("cebola", 7.99, 10)
tomate= Produto("tomate", 7.30, 1)
cebola.imprimir()
tomate.imprimir()
total_cebola = cebola.calcular_total()
print("valor total do produto:", total_cebola)
total_tomate = tomate.calcular_total()
print("valor total do produto:", total_tomate)
