class Produto:
    def __init__(self, nome,preco,quantidade_estq):
        self.nome=nome
        self.preco=preco
        self.quantidade_estq= quantidade_estq
    def imprimir(self):
        print("nome:", self.nome)
        print("preco:", self.preco)
        print("quantidade:", self.quantidade_estq)
    def atualizar_estoque(self, valor):
        self.quantidade_estq= self.quantidade_estq+valor
print("antes")
banana= Produto("banana",5.99, 3)
milho = Produto("milho", 11, 50)
banana.imprimir()
milho.imprimir()

print("depois")
banana.atualizar_estoque(400)
milho.atualizar_estoque(100)
banana.imprimir()
milho.imprimir()
            
