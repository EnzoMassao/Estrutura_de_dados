class Contato:
    def __init__(self, nome, telefone, email):
        self.nome= nome
        self.telefone= telefone
        self.email= email

rodrigo= Contato("rodrigo", 55123456789, "rodrigo@gmail.com")
breno= Contato("breno", 55987654321, "brenoo@gmail.com")
ana= Contato("ana", 55123459876, "ana@gmail.com")
agenda =[rodrigo, breno, ana]

for contato in agenda:
    print("Nome:", contato.nome)
    print("telefone:", contato.telefone)
    print("email:", contato.email)
