class Livro:
    def __init__(self, titulo, autor, n_paginas):
        self.titulo= titulo
        self.autor= autor
        self.n_paginas= n_paginas
        
    def imprimir(self):
        print("titulo do livro:", self.titulo)
        print("autor do livro:", self.autor)
        print("Numero de paginas:", self.n_paginas)
    def qtd_paginas(self):
        if self.n_paginas > 100:
            print("livro longo")
        else:
            print("livro curto")

metamorfose= Livro("Metamorfose","Franz Kafka",1444)
