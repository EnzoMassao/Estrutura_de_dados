class No:
    def __init__(self,chamado):
        self.chamado=chamado
        self.proximo=None
        self.anterior=None

class Deque:
    def __init__(self):
        self.head=None  
        self.tail=None   
    def inserir_cabeca(self,chamado):
        novo=No(chamado)
        if self.head == None:
            self.head=self.tail=novo
            return
        novo.proximo=self.head
        self.head.anterior=novo
        self.head=novo
    def inserir_cauda(self,chamado):
        novo =  No(chamado)
        if self.head is None:
            self.head=self.tail=novo
            return
        novo.anterior=self.tail
        self.tail.proximo=novo
        self.tail=novo
    def remover_cabeca(self):
        if self.head is None:
            print("deque vazio")
            return
        if self.head.proximo is None:
            self.head = self.tail=None
            print("cabeca removida, deque vazio")
            return
        self.head=self.head.proximo
        self.head.anterior=None
    
    def remover_cauda(self):
        if self.head is None:
            print("deque vazio")
            return
        if self.tail.anterior is None:
            self.head=self.tail=None
            print("cauda removida, deque vazio")
            return
       
        self.tail=self.tail.anterior
        self.tail.proximo=None
            
    def mostrar_cabeca(self):
        if self.head is None:
            print("deque vazio")
            return
        aux=self.head
        while aux is not None:
            print("-", aux.chamado)
            aux=aux.proximo

    def mostrar_cauda(self):
        aux= self.tail
        if self.head is None:
            print("deque vazio")
            return
        while aux is not None:
            print("-",aux.chamado)
            aux=aux.anterior
