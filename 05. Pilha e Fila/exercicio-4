class No:
    def __init__(self, jogador):
        self.jogador= jogador
        self.proximo= None
        self.anterior= None


def inserir(fila_inicio,fila_fim,jogador):
    novo = No(jogador)
    if fila_inicio is None:
        fila_inicio= novo
        fila_fim = novo
        return fila_inicio, fila_fim
    fila_fim.proximo=novo
    fila_fim=novo
    return fila_inicio, fila_fim
