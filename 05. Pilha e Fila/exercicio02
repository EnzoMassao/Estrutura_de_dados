class No:
    def __init__(self,dado):
        self.dado= dado
        self.proximo= None
        


def inserir(pilha,dado):
    novo= No(dado)

    if pilha == None:
        pilha =novo
        return pilha
    novo.proximo=pilha
    pilha= novo
    return pilha

def pop(pilha):
    if pilha ==None:
        print("pilha vazia.")
        return None,pilha
    dado= pilha.dado
    pilha= pilha.proximo
    return dado,pilha
def mostrar_ultimo(pilha):
    
    if pilha is None:
        print("pilha vazia")
        return None
    print(pilha.dado)
def lista(pilha):
    aux= pilha
    contador = 1
    if pilha is None:
        print("pilha vazia")
        return None
    while aux != None:
        print(contador, "-", aux.dado)
        aux= aux.proximo
        contador += 1

def menu():
    print("1- inserir")
