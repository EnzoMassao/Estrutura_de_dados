class No:
    def __init__(self,dado):
        self.dado= dado
        self.proximo= None
def inserir(pilha,dado):
    novo = No(dado)
    if pilha == None:
        pilha = novo
        return pilha
    novo.proximo= pilha
    pilha= novo
    return pilha
def remover(pilha,dado):
    aux= pilha
    carro_atual= None
    if pilha is None:
        print("pilha vazia")
        return pilha
    while aux != None and carro_atual != dado:
        carro_atual= aux.dado
        aux= aux.proximo
        print("carro removido=", carro_atual)
    return aux
    
