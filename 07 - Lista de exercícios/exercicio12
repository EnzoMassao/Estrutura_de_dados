class Pilha:
    def __init__(self,dado):
        self.dado=dado
        self.proximo= None

def empilhar(pilha,dado):
    novo= Pilha(dado)
    if pilha is None:
        pilha = novo
        return pilha
    novo.proximo=pilha
    pilha =novo
    return pilha

