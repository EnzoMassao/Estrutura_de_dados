class Pessoas:
    def __init__(self,nome,idade):
        self.nome=nome
        self.idade=idade

    def apresentar(self):
        print("Nome da pessoa=", self.nome)
        print("Idade da pessoa=", self.idade)

joao= Pessoas("Joao", 14)
felipe= Pessoas("Felipe", 19)
joao.apresentar()
felipe.apresentar()
