class No:
    def __init__(self,usuario):
        self.usuario=usuario
        self.proximo=None
        self.anterior= None
def enfilerar(fila_inicio, fila_fim,usuario):
    novo= No(usuario)
    if fila_inicio is None:
        fila_inicio= novo
        fila_fim= novo
        return fila_inicio, fila_fim
    fila_fim.proximo= novo
    novo.anterior=fila_fim
    fila_fim= novo
    return fila_inicio,fila_fim

def desenfilerar(fila_inicio,fila_fim):
    if fila_inicio is None:
        print("fila vazia")
        return fila_inicio,fila_fim
    if fila_inicio == fila_fim:
        fila_inicio= None
        fila_fim= None
        return fila_inicio,fila_fim
    fila_inicio= fila_inicio.proximo
    fila_inicio.anterior=None
    return fila_inicio, fila_fim
def listar(fila_inicio):
    aux= fila_inicio
