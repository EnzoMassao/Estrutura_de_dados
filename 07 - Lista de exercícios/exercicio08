class NoDuplo:
    def __init__(self,nome):
        self.nome= nome
        self.proximo= None
        self.anterior= None
class ListaDuplamente:
    def __init__(self):
        self.cabeca=None
        self.cauda= None
    def adicionar_inicio(self,nome):
        novo= NoDuplo(nome)
        if self.cabeca is None:
            self.cabeca= novo
            self.cauda= novo
            return self
        else:
            novo.proximo= self.cabeca
            self.cabeca.anterior= novo
            self.cabeca= novo

    def percorrer_frente(self):
        aux = self.cabeca
        contador = 1
        if self.cabeca is None:
            print("lista vazia")
            return
        while aux is not None:
            print("-", contador, "=",aux.nome)
            contador +=1      
            aux= aux.proximo
    def percorrer_tras(self):
        aux=self.cauda
        contador= 1
        if self.cabeca is None:
            print("lista vazia")
            return
        while aux is not None:
            print(contador,"-", aux.nome)
            contador +=1
            aux=aux.anterior

def menu():
    print("1- inserir jogador:")
    print("2- percorrer lista:")
    print("3-percorrer para tras")
    print("4- sair")
    opcao = int(input("digite a opcao que deseja:"))
    return opcao
def main():
    
    opcao = 0
    time= ListaDuplamente()
    while opcao != 4:
        opcao = menu()
        if opcao ==1:
            nome= input("digite o nome do jogador:")
            time.adicionar_inicio(nome)
        elif opcao ==2:
            time.percorrer_frente()
        elif opcao ==3:
            time.percorrer_tras()
        elif opcao ==4:
            print("saindo..")
        else:
            print("opcao invalida")
main()
        
