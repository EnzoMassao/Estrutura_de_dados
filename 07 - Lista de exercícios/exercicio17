class No:
    def __init__(self,usuario,tempo):
        self.usuario=usuario
        self.tempo= tempo
        self.proximo= None
        self.anterior= None
def enfilerar(fila_inicio,fila_fim,usuario,tempo):
    novo= No(usuario,tempo)
    if fila_inicio is None:
        fila_inicio= novo
        fila_fim=novo
        return fila_inicio,fila_fim
    fila_fim.proximo= novo
    novo.anterior=fila_fim
    fila_fim= novo
    return fila_inicio,fila_fim
def desenfilerar(fila_inicio,fila_fim):
    if fila_inicio is None:
        print("fila vazia")
        return fila_inicio,fila_fim
    if fila_inicio == fila_fim:
        fila_inicio =None
        fila_fim= None
        return fila_inicio,fila_fim
    fila_inicio= fila_inicio.proximo
    fila_inicio.anterior=None
    return fila_inicio,fila_fim
def percorrer(fila_inicio):
    aux= fila_inicio
    contador =1
    if fila_inicio is None:
        print("fila vazia")
        return
    while aux is not None:
        print(contador , "-", aux.usuario)
        contador +=1
        aux= aux.proximo
def frente(fila_inicio):
    if fila_inicio is None:
        print("fila vazia") 
        return
    return fila_inicio.usuario
def estar_vazia(fila_inicio):
    return fila_inicio is None

def aguardando(fila_inicio):
    aux= fila_inicio
    contador =0
    while aux is not None:
        print("total de usuarios:", contador)
        contador +=1

        aux= aux.proximo
    return contador
    
def tempoEspera(fila_inicio):
    aux= fila_inicio
    somaTempo=0
    contador=0
    if fila_inicio is None:
        print("fila vazia")
        return
    while aux is not None:
        somaTempo+= aux.tempo
        contador +=1
        aux=aux.proximo
    return somaTempo/contador

