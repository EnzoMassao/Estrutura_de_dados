class No:
    def __init__(self,dado):
        self.dado =dado
        self.proximo= None
def menu():
    print("1 - Inserir item")
    print("2 - Listar itens")
    print("3 - Retirar item")
    print("4 - contar maiores que n")
    print("5- mostrar ultimo elemento")
    print("6 - inserir no final")
    print("7 - calcular a media")
    print("8 - Inverter os sinais")
    print("9- sair")
    opcao = int(input("Digite a opcao:"))
    return opcao
def inserir(lista,dado):
    no= No (dado)
    if lista ==None:
        lista=no
        return lista
    no.proximo =lista
    lista =no
    return lista
def listar(lista):
    aux =lista
    while aux !=None:
        print(" - ", aux.dado)
        aux = aux.proximo
def remover (lista,dado):
    aux =lista
    anterior = None
    if lista==  None:
        print("lista vazia.")
        return
    while aux!= None:
        if aux.dado ==dado:
            if aux== lista:
                lista =lista.proximo
                return lista
            else:
                anterior.proximo= aux.proximo
                return lista
        anterior =aux
        aux=aux.proximo
    print("Dado nao encontrado.")
    return lista
def maiores(lst,n):
    aux =lst
    contador =0
    while aux!= None:
        if aux.dado >n:
            contador +=1
        aux = aux.proximo
    return contador
def ultimo(lista):
    if lista == None:
        return None
    aux = lista
    while aux.proximo != None:
        aux= aux.proximo
    return aux
def lista_insere_final(lst, valor):
    no = No(valor)
    if lst ==None:
        lst= no
        return lst
    aux = lst
    while aux.proximo != None:
        aux = aux.proximo
    aux.proximo = no
    return lst
def lista_calcula_media(lst):
    if lst == None:
        return 0
    aux = lst
    soma = 0 
    quantidade = 0
    while aux != None:
        soma = soma + aux.dado 
        quantidade = quantidade + 1
        aux = aux.proximo
    media = soma / quantidade
    return media
def list_altera(lst):
    aux = lst
    while aux != None:
        aux.dado = aux.dado * -1
        aux= aux.proximo
def main():
    lista =None
    opcao = 0
    while opcao!= 9:
        opcao = menu()
        if opcao ==1:
            dado = float(input("Digite um dado:"))
            lista = inserir(lista, dado)
        elif opcao == 2:
            listar(lista)
        elif opcao == 3:
            dado = float(input("Dado para retirar:"))
            lista = remover(lista, dado)
        elif opcao ==4:
            n= float(input("Digite o numero:"))
            total= maiores(lista,n)
            print("quantidade de numeros maiores que" , n ,"=", total)
        elif opcao ==5:
            no = ultimo(lista)
            if no==None:
                print("lista vazia")
            else:
                print("ultimo elemento:", no.dado)
        elif opcao ==6:
            dado = float(input("digite um dado para inserir no final:"))
            lista = lista_insere_final(lista, dado)
        elif opcao == 7:
            media = lista_calcula_media(lista)
            print("media:", media)
        elif opcao == 8:
            list_altera(lista)
            print("Sinais invertidos!")
        elif opcao == 9:
            print("saindo...")
        else:
            print("opcao invalida")
main()
