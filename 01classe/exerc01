class Produto:
    def __init__(self,nome, preco,qtd_estoque):
        self.nome=nome
        self.preco=preco
        self.qtd_estoque= qtd_estoque

    def imprirmir(self):
        print("produto:", self.nome)
        print("valor:", self.preco)
        print("Quantidade no estoque:", self.qtd_estoque)

    def adicionar_produto(self,quantidade):
        self.qtd_estoque+=quantidade

    def remover_produto(self,quantidade):
        if quantidade <= self.qtd_estoque:
            self.qtd_estoque-=quantidade
        else:
            print("falta de estoque!")
    def calcular_total(self):
        valor_total= self.qtd_estoque*self.preco
        return valor_total
    
leite =Produto("leite", 5.8, 200)
